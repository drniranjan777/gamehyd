{
  "name": "real-world-battle-royale",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @rwbr/database migrate",
    "dev:api": "pnpm --filter @rwbr/api dev",
    "dev:web": "pnpm --filter @rwbr/web dev",
    "dev:admin": "pnpm --filter @rwbr/admin dev"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
