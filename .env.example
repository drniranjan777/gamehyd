PORT=3001
# Local dev database (see database/README.md). Never commit real credentials.
DATABASE_URL=postgres://rwbr_app@localhost:55432/rwbr_dev

# Secrets: generate fresh values per environment, keep them in the secrets manager.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-dev-only-0123456789abcdef0123456789abcdef
SERVER_SHARED_SECRET=change-me-dev-only-server-0123456789abcdef0123456789
# Shared with match servers (--ticket-secret-hex), see docs/adr/0007.
TICKET_SECRET_HEX=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MIN_CLIENT_VERSION=0.1.0
MATCH_CAPACITY=30
MATCH_MIN_PLAYERS=2
MATCH_FILL_WAIT_SECONDS=20
DEFAULT_MAP_VERSION=hyd-city-v1
RATE_LIMIT_ENABLED=true
LOG_REQUESTS=true
TRUST_PROXY=false

# Store and payments. Real verification needs the platform credentials (see docs/adr/0009).
DEV_PURCHASES_ENABLED=true
DEV_PURCHASE_SECRET=change-me-dev-only-purchases-0123456789abcdef
# GOOGLE_PLAY_PACKAGE_NAME=com.rwbr.battleroyale
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
# GOOGLE_RTDN_AUDIENCE=https://api.example.com/api/v1/webhooks/google
# GOOGLE_RTDN_SERVICE_ACCOUNT=rtdn-push@project.iam.gserviceaccount.com
# APPLE_BUNDLE_ID=com.rwbr.battleroyale
# APPLE_ROOT_CERT_PEM="-----BEGIN CERTIFICATE-----..."   (Apple Root CA - G3)
ORDER_PENDING_TTL_HOURS=24
RECONCILE_INTERVAL_SECONDS=600
ACCOUNT_DELETION_GRACE_DAYS=30

# Admin portal: key that encrypts admin TOTP secrets.
ADMIN_TOTP_KEY_HEX=0f0e0d0c0b0a09080706050403020100f0e0d0c0b0a090807060504030201000
ADMIN_SESSION_HOURS=8
